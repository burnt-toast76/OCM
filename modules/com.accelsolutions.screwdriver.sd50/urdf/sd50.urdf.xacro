<?xml version="1.0"?>
<!--
  STUB collision geometry: an axis-aligned box, not real CAD. Footprint
  from mechanical.mount.footprint_mm (70x70 mm); height from the
  frames.tcp z-offset already in module.yaml (186.5 mm, flange to bit tip
  fully retracted); both numbers this file derives from are declared in
  the manifest, not measured here. Replace when a real convex hull /
  vendor mesh is authored.
-->
<robot name="frag">
  <link name="origin">
    <collision>
      <origin xyz="0 0 0.09325" rpy="0 0 0"/>
      <geometry><box size="0.07 0.07 0.1865"/></geometry>
    </collision>
  </link>
</robot>
