<?xml version="1.0"?>
<!--
  STUB collision geometry: an axis-aligned box, not real CAD. Footprint
  from mechanical.mount.footprint_mm (90x60 mm); height from the
  frames.tcp z-offset already in module.yaml (142.0 mm, flange to nozzle
  exit); both numbers this file derives from are declared in the
  manifest, not measured here. Replace when a real convex hull / vendor
  mesh is authored.
-->
<robot name="frag">
  <link name="origin">
    <collision>
      <origin xyz="0 0 0.071" rpy="0 0 0"/>
      <geometry><box size="0.09 0.06 0.142"/></geometry>
    </collision>
  </link>
</robot>
