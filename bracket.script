# sd1 fastening sequence (3 hole(s)) -- generated by `ocm plan --emit-urscript`
#
# spec/08-robot-handshake.md, `ur-rtde` binding. Register map (RTDE
# general-purpose integer registers; registers 0-1 are reserved by the spec):
#   hs_at_step    -> write_output_integer_register(0, N)   -- this program writes
#   hs_heartbeat  -> write_output_integer_register(1, k)   -- this program writes, every wait iteration
#   hs_done_step  -> read_input_integer_register(0)        -- coordinator writes; level-based: wait for >= N
#   hs_abort      -> read_input_integer_register(1)        -- coordinator writes; nonzero => halt in place
# Step numbers are monotonic in plan order, starting at 1: one at each
# hole's standoff (gates the descent to contact on that hole's own
# preconditions, e.g. screw_present) and one at contact (gates leaving
# contact on the drive result, e.g. result_ok). Transit/retract moves
# are not gated.
#
# Every movel pose below targets the FLANGE (tool0) -- no set_tcp() is
# issued. The screwdriver's own TCP offset is a fixed, known translation
# from the flange (sd50's own `tcp` frame), so the bit lands correctly as
# a direct consequence of the flange landing correctly.
#
# on_fail (eject_screw, reject_part) is PLC-side logic -- not emitted here, see ADR-0004

hb = 0

# PLC handshake: load_screw (overlaps following transit)
movej([-0.570869, -1.673328, 2.250992, 0.993133, 1.570796, -0.570869])  # shoulder_pan_joint, shoulder_lift_joint, elbow_joint, wrist_1_joint, wrist_2_joint, wrist_3_joint
# sync: standoff @ hole_1 (step 1) -- coordinator gates this on drive_screw's own preconditions
write_output_integer_register(0, 1)
while read_input_integer_register(0) < 1:
  if read_input_integer_register(1) != 0:
    halt
  end
  hb = hb + 1
  write_output_integer_register(1, hb)
  sleep(0.05)
end
movel(p[-0.228000, -0.012000, 0.246500, -2.221441, 2.221441, 0.000000], v=0.020000)
# sync: contact @ hole_1 (step 2) -- coordinator runs drive_screw and checks result_ok
write_output_integer_register(0, 2)
while read_input_integer_register(0) < 2:
  if read_input_integer_register(1) != 0:
    halt
  end
  hb = hb + 1
  write_output_integer_register(1, hb)
  sleep(0.05)
end
movel(p[-0.228000, -0.012000, 0.286500, -2.221441, 2.221441, 0.000000], v=0.020000)
# PLC handshake: load_screw (overlaps following transit)
movej([-0.985112, -1.996541, 2.468942, 1.098396, 1.570796, -0.985112])  # shoulder_pan_joint, shoulder_lift_joint, elbow_joint, wrist_1_joint, wrist_2_joint, wrist_3_joint
# sync: standoff @ hole_2 (step 3) -- coordinator gates this on drive_screw's own preconditions
write_output_integer_register(0, 3)
while read_input_integer_register(0) < 3:
  if read_input_integer_register(1) != 0:
    halt
  end
  hb = hb + 1
  write_output_integer_register(1, hb)
  sleep(0.05)
end
movel(p[-0.152000, -0.012000, 0.246500, -2.221441, 2.221441, 0.000000], v=0.020000)
# sync: contact @ hole_2 (step 4) -- coordinator runs drive_screw and checks result_ok
write_output_integer_register(0, 4)
while read_input_integer_register(0) < 4:
  if read_input_integer_register(1) != 0:
    halt
  end
  hb = hb + 1
  write_output_integer_register(1, hb)
  sleep(0.05)
end
movel(p[-0.152000, -0.012000, 0.286500, -2.221441, 2.221441, 0.000000], v=0.020000)
# PLC handshake: load_screw (overlaps following transit)
movej([-0.402419, -1.767103, 2.326820, 1.011079, 1.570796, -0.402419])  # shoulder_pan_joint, shoulder_lift_joint, elbow_joint, wrist_1_joint, wrist_2_joint, wrist_3_joint
# sync: standoff @ hole_3 (step 5) -- coordinator gates this on drive_screw's own preconditions
write_output_integer_register(0, 5)
while read_input_integer_register(0) < 5:
  if read_input_integer_register(1) != 0:
    halt
  end
  hb = hb + 1
  write_output_integer_register(1, hb)
  sleep(0.05)
end
movel(p[-0.190000, -0.064000, 0.246500, -2.221441, 2.221441, 0.000000], v=0.020000)
# sync: contact @ hole_3 (step 6) -- coordinator runs drive_screw and checks result_ok
write_output_integer_register(0, 6)
while read_input_integer_register(0) < 6:
  if read_input_integer_register(1) != 0:
    halt
  end
  hb = hb + 1
  write_output_integer_register(1, hb)
  sleep(0.05)
end
movel(p[-0.190000, -0.064000, 0.286500, -2.221441, 2.221441, 0.000000], v=0.020000)
movej([0.000000, -1.570796, 1.570796, 0.000000, 0.000000, 0.000000])  # shoulder_pan_joint, shoulder_lift_joint, elbow_joint, wrist_1_joint, wrist_2_joint, wrist_3_joint
