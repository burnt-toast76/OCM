    "endpoint": {
      "type": "object",
      "description": "ADR-0015: one end of a net or link. References EXISTING field names only, no renaming or alias layer -- `port` is a ports[].id, `refdes` is a components[].refdes, `ref`/`pin` are exactly what the referenced component's own connector/pin calls itself (ComponentConnector.ref, ComponentPin.pin -- see ocm-component-1.0.schema.json). Whether a given combination is actually valid for its domain (e.g. an unknown refdes, or a pin that connector doesn't have) is a resolve-time concern, not schema-enforced here.",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "string",
