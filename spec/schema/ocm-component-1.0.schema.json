{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencellmodule.org/schema/ocm-component-1.0.schema.json",
  "title": "OCM Component Definition v1.0 (draft)",
  "type": "object",
  "required": [
    "ocm_version",
    "id",
    "revision",
    "kind",
    "vendor",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "ocm_version": {
      "const": "1.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string"
    },
    "vendor": {
      "type": "string"
    },
    "part_number": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "datasheet",
            "manual",
            "catalog",
            "measured"
          ]
        },
        "ref": {
          "type": "string",
          "description": "URL, filename, or citation. Provenance is mandatory: every component names where its facts came from."
        },
        "date": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "kind": {
      "anyOf": [
        {
          "enum": [
            "vacuum_ejector",
            "io_link_master",
            "valve_island",
            "sensor",
            "camera",
            "actuator",
            "drive",
            "gripper_body",
            "dispenser",
            "feeder_body",
            "bracket",
            "other"
          ]
        },
        {
          "type": "string",
          "pattern": "^x-[a-z0-9][a-z0-9-]*$"
        }
      ]
    },
    "electrical": {
      "type": "object",
      "properties": {
        "supplies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rail"
            ],
            "properties": {
              "rail": {
                "enum": [
                  "24VDC",
                  "48VDC",
                  "120VAC",
                  "240VAC",
                  "400VAC-3P"
                ]
              },
              "current_nominal_a": {
                "type": "number"
              },
              "current_peak_a": {
                "type": "number"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "connectors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "carries": {
                "type": "string"
              },
              "pins": {
                "type": "array",
                "description": "This connector's own pinout, as the source states it.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "pin",
                    "function"
                  ],
                  "properties": {
                    "pin": {
                      "type": "string",
                      "description": "Pin identifier as the datasheet labels it (e.g. '1', 'A', 'GND')."
                    },
                    "function": {
                      "type": "string",
                      "description": "What this pin is for, as the source states it (e.g. '24VDC supply', 'output_1 signal')."
                    },
                    "wire_color": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "pneumatic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pressure_min": {
          "type": "number"
        },
        "pressure_max": {
          "type": "number"
        },
        "pressure_units": {
          "type": "string",
          "description": "Verbatim as printed (e.g. 'bar', 'psi') -- never convert."
        },
        "flow": {
          "type": "number"
        },
        "flow_units": {
          "type": "string",
          "description": "Verbatim as printed (e.g. 'Nl/min') -- never convert."
        },
        "ports": {
          "type": "array",
          "description": "This component's own pneumatic ports, as the source states them. A single-port device (most dispensers/actuators) still gets a one-entry list. Every field is independently optional -- a datasheet rarely states all three for one port; include only what it actually says (ADR-0014).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "port": {
                "type": "string",
                "description": "Port label as the datasheet prints it (e.g. 'P', 'A', 'R'). Omit if the source never labels it -- do not invent one for a single unlabeled port."
              },
              "thread": {
                "type": "string",
                "description": "Verbatim as printed (e.g. 'G1/8', '1/4in NPT')."
              },
              "function": {
                "type": "string",
                "enum": [
                  "supply",
                  "exhaust",
                  "work"
                ],
                "description": "What this port does, per the source's own description. Omit if none of the three fits (e.g. a sensor's process-pressure tap is none of these)."
              }
            }
          }
        }
      },
      "description": "Ranges as stated. A single operating point is a MODULE decision (ADR-0014)."
    },
    "comms": {
      "type": "object",
      "properties": {
        "protocol": {
          "anyOf": [
            {
              "enum": [
                "ethercat",
                "ethernet-ip",
                "profinet",
                "modbus-tcp",
                "opc-ua",
                "io-link",
                "discrete-io",
                "ur-rtde"
              ]
            },
            {
              "type": "string",
              "pattern": "^x-[a-z0-9][a-z0-9-]*$"
            }
          ]
        },
        "device_description": {
          "type": "string",
          "description": "Citation for the ESI/IODD/EDS (e.g. 'ESI available from vendor'). NEVER a path to a file that does not exist."
        },
        "connectors": {
          "type": "array",
          "description": "This component's own comms/network connectors, as the source states them (e.g. an EtherCAT IN/OUT pair on a daisy-chainable device). This is what makes an EtherCAT chain expressible one layer up, in a module's own comms.connectors. Absence is correct, not a gap to fill in, for a device whose datasheet never enumerates them (e.g. a discrete-io device with no chainable network) -- never fabricated.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "description": "This connector's own label, as the source states it (e.g. 'X1 IN', 'X2 OUT')."
              },
              "type": {
                "type": "string",
                "description": "Connector type, as printed (e.g. 'M12-D-4P')."
              },
              "protocol": {
                "type": "string",
                "description": "Only if the source states a protocol for THIS connector that differs from (or is more specific than) the device's own comms.protocol -- otherwise omit; it's implied."
              },
              "role": {
                "type": "string",
                "enum": [
                  "master",
                  "slave_in",
                  "slave_out",
                  "port"
                ],
                "description": "As the datasheet labels it -- 'IN'/'OUT' on an EtherCAT slave map to slave_in/slave_out."
              }
            }
          }
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "direction_device",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "direction_device": {
                "enum": [
                  "input",
                  "output"
                ],
                "description": "From the DEVICE's perspective, as the datasheet states it. Coordinator-perspective mapping happens at the module boundary."
              },
              "type": {
                "enum": [
                  "bool",
                  "int16",
                  "uint16",
                  "int32",
                  "uint32",
                  "real",
                  "string",
                  "pose6d",
                  "vec3",
                  "struct"
                ]
              },
              "unit": {
                "type": "string"
              },
              "electrical": {
                "type": "string",
                "description": "e.g. 'PNP', 'NPN', '0-10V' as stated"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "envelope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "length": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "units": {
              "type": "string",
              "description": "Verbatim as printed (e.g. 'mm', 'in') -- never convert."
            }
          }
        },
        "mass": {
          "type": "number"
        },
        "units": {
          "type": "string",
          "description": "Verbatim as printed (e.g. 'kg', 'lb') -- never convert."
        }
      }
    },
    "hazards": {
      "type": "array",
      "items": {
        "enum": [
          "pinch",
          "crush",
          "puncture",
          "burn_hot",
          "burn_cryo",
          "laser",
          "uv",
          "chemical",
          "pressure",
          "electrical",
          "noise",
          "rotating",
          "aerosol"
        ]
      }
    },
    "notes": {
      "type": "string",
      "description": "Cautions and requirements carried from the source, near-verbatim."
    }
  }
}